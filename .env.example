# Plataforma Cidade Imperial — configuração por variáveis de ambiente
#
# Copie este arquivo para `.env` (na raiz do projeto) e ajuste os valores.
#   cp .env.example .env
# Variáveis já definidas no ambiente do sistema têm prioridade sobre o `.env`.
# Todos os campos têm um padrão sensato — o arquivo pode ficar vazio para rodar
# com o banco embutido.

# ─── Servidor HTTP ───────────────────────────────────────────────────────────
# Porta em que a aplicação escuta.
PORT=3000
# Interface de rede. 0.0.0.0 aceita conexões externas; 127.0.0.1 apenas locais.
HOST=0.0.0.0
# Tamanho máximo do corpo JSON aceito pela API.
JSON_BODY_LIMIT=8mb
# URL pública, usada apenas nas mensagens de log (opcional).
# PUBLIC_URL=https://plataforma.cervejariacidadeimperial.com.br

# ─── Interface web ───────────────────────────────────────────────────────────
# Pasta com o build da web servido pela API. Vazio = detecção automática.
# WEB_DIST=

# ─── Banco de dados ──────────────────────────────────────────────────────────
# Driver: auto | pglite | postgres
#   auto     = postgres se houver DATABASE_URL/PG*, senão pglite (padrão)
#   pglite   = PostgreSQL embutido (WASM), sem servidor externo
#   postgres = força o uso de um servidor PostgreSQL
DB_DRIVER=auto

# --- Opção A: PostgreSQL embutido (PGlite) ---
# Pasta onde os dados são gravados.
PGLITE_DIR=server/.pgdata

# --- Opção B: seu servidor PostgreSQL ---
# Forma 1: uma única URL de conexão.
# DATABASE_URL=postgres://usuario:senha@localhost:5432/cidadeimperial
# Forma 2: variáveis separadas (usadas se DATABASE_URL não estiver definida).
# PGHOST=localhost
# PGPORT=5432
# PGUSER=postgres
# PGPASSWORD=sua_senha
# PGDATABASE=cidadeimperial
# Conexão TLS/SSL (bancos gerenciados costumam exigir). true para ativar.
# PGSSL=false

# ─── Comportamento de inicialização do banco ─────────────────────────────────
# Cria o banco automaticamente se ele não existir (precisa de permissão).
DB_AUTO_CREATE=true
# Carrega os dados iniciais de demonstração quando o banco está vazio.
DB_SEED=true

# ─── Análise fiscal por IA (documento do faturamento) ───────────────────────
# O fornecedor é obrigado a anexar o PDF ou XML do documento fiscal ao
# registrar um faturamento. Com esta chave configurada, a análise do documento
# (confere se ele se refere ao pedido) é feita pela IA Claude (API Anthropic);
# sem a chave, um analisador local do servidor é usado. O flag que liga/desliga
# a análise fica na tela "Configurações Técnicas > Análise fiscal (IA)".
# ANTHROPIC_API_KEY=sk-ant-...
